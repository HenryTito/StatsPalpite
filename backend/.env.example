# Ambiente
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:3333

# Banco (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=statspalpite
DB_USER=statspalpite
DB_PASS=statspalpite
DB_NAME_TEST=statspalpite_test

# Autenticação (RF01, RF76)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Janela do link de recuperação de senha, em minutos (RF02)
PASSWORD_RESET_EXPIRES_IN_MINUTES=15

# SMTP para Nodemailer (RF02). Vazio = modo console, imprime o e-mail no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StatsPalpite <nao-responda@statspalpite.app>"

# Provedores externos (RF03, RF04, RF15, RF36, RF62).
# Sem chave, o provider local assume e o app continua funcional.
FOOTBALL_PRIMARY=local
FOOTBALL_SECONDARY=local
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
OPENWEATHERMAP_KEY=

# Cache do motor de ingestão, em segundos (B008, RNF03)
CACHE_TTL_MATCHES=300
CACHE_TTL_STATISTICS=900
CACHE_TTL_WEATHER=1800
CACHE_TTL_INJURIES=3600
CACHE_TTL_REFEREE=86400

# Rede e segurança
# Quantos proxies há na frente da API. 0 = sem proxy; o X-Forwarded-For é
# ignorado. Ligar isto sem proxy real permite forjar o IP e burlar o limite
# de tentativas de login.
TRUST_PROXY_HOPS=0
# Origens permitidas pelo CORS, separadas por vírgula. Vazio libera todas.
CORS_ORIGINS=
# Devolve o token de redefinição no corpo da resposta, para teste manual sem
# caixa de e-mail. NUNCA em produção — o ambiente recusa.
EXPOSE_RESET_TOKEN=false

# Observabilidade (RNF08). Vazio desativa.
SENTRY_DSN=
